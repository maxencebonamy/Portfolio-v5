{
	"name": "portfolio",
	"version": "0.1.0",
	"private": true,
	"description": "Personal portfolio of Maxence Bonamy, software engineer.",
	"author": "Maxence Bonamy",
	"license": "MIT",
	"packageManager": "pnpm@12.14.0",
	"type": "module",
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "pnpm run schemas --check && vite build && tsc -b && pnpm run sitemap",
		"preview": "vite preview",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"typecheck": "tsc -b",
		"schemas": "tsx --tsconfig tsconfig.node.json scripts/generate-schemas.ts",
		"sitemap": "tsx --tsconfig tsconfig.node.json scripts/generate-sitemap.ts",
		"media:videos": "tsx --tsconfig tsconfig.node.json scripts/encode-videos.ts",
		"media:images": "tsx --tsconfig tsconfig.node.json scripts/generate-images.ts",
		"media:pull": "tsx --tsconfig tsconfig.node.json scripts/sync-originals.ts pull",
		"media:push": "tsx --tsconfig tsconfig.node.json scripts/sync-originals.ts push",
		"check": "pnpm run typecheck && pnpm run lint && pnpm run schemas --check"
	},
	"dependencies": {
		"@tanstack/react-router": "^1.170.46",
		"@tanstack/react-start": "^1.169.7",
		"clsx": "^2.1.1",
		"lenis": "^1.3.27",
		"motion": "^14.14.0",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"tailwind-merge": "^3.7.0",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@eslint/js": "^9.39.5",
		"@stylistic/eslint-plugin": "^5.10.0",
		"@tailwindcss/vite": "^4.3.5",
		"@types/eslint-plugin-jsx-a11y": "^6.10.1",
		"@types/node": "^26.6.6",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^6.3.0",
		"eslint": "^9.39.5",
		"eslint-plugin-import": "^2.32.0",
		"eslint-plugin-jsx-a11y": "^6.10.2",
		"eslint-plugin-react-hooks": "^7.1.1",
		"eslint-plugin-simple-import-sort": "^14.0.0",
		"globals": "^17.14.0",
		"jiti": "^2.7.0",
		"sharp": "^0.35.5",
		"tailwindcss": "^4.3.5",
		"tsx": "^4.23.15",
		"typescript": "~6.0",
		"typescript-eslint": "^8.73.0",
		"vite": "^8.3.8"
	}
}
