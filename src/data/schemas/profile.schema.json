{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"title": "profile.json",
	"type": "object",
	"properties": {
		"$schema": {
			"type": "string"
		},
		"firstName": {
			"type": "string",
			"minLength": 1
		},
		"lastName": {
			"type": "string",
			"minLength": 1
		},
		"jobTitle": {
			"type": "object",
			"properties": {
				"fr": {
					"type": "string",
					"minLength": 1
				},
				"en": {
					"type": "string",
					"minLength": 1
				}
			},
			"required": [
				"fr",
				"en"
			],
			"additionalProperties": false
		},
		"company": {
			"type": "string",
			"minLength": 1
		},
		"location": {
			"type": "string",
			"minLength": 1,
			"description": "City shown in the hero and the footer."
		},
		"timeZone": {
			"type": "string",
			"minLength": 1,
			"description": "IANA time zone of the local clock, e.g. Europe/Paris."
		},
		"email": {
			"type": "string",
			"format": "email",
			"pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
		},
		"codingSince": {
			"type": "integer",
			"minimum": -9007199254740991,
			"maximum": 9007199254740991,
			"description": "Year I started programming."
		},
		"proSince": {
			"type": "integer",
			"minimum": -9007199254740991,
			"maximum": 9007199254740991,
			"description": "Year my professional experience started."
		},
		"openToWork": {
			"type": "boolean",
			"description": "Shows the \"open to freelance work\" badges."
		},
		"resume": {
			"type": "object",
			"properties": {
				"fr": {
					"type": "string",
					"format": "starts_with",
					"pattern": "^\\/.*"
				},
				"en": {
					"type": "string",
					"format": "starts_with",
					"pattern": "^\\/.*"
				}
			},
			"required": [
				"fr",
				"en"
			],
			"additionalProperties": false,
			"description": "Resume PDF in each language, relative to `public/`."
		},
		"photo": {
			"type": "object",
			"properties": {
				"src": {
					"type": "string",
					"format": "starts_with",
					"pattern": "^\\/.*"
				},
				"srcWebp": {
					"type": "string",
					"format": "starts_with",
					"pattern": "^\\/.*"
				},
				"width": {
					"type": "integer",
					"exclusiveMinimum": 0,
					"maximum": 9007199254740991
				},
				"height": {
					"type": "integer",
					"exclusiveMinimum": 0,
					"maximum": 9007199254740991
				}
			},
			"required": [
				"src",
				"srcWebp",
				"width",
				"height"
			],
			"additionalProperties": false,
			"description": "Cut-out portrait, relative to `public/`."
		},
		"socials": {
			"type": "array",
			"items": {
				"type": "object",
				"properties": {
					"label": {
						"type": "string",
						"minLength": 1,
						"description": "Network name, e.g. GitHub."
					},
					"href": {
						"type": "string",
						"format": "uri"
					},
					"handle": {
						"type": "string",
						"minLength": 1,
						"description": "Short handle shown next to the label."
					}
				},
				"required": [
					"label",
					"href",
					"handle"
				],
				"additionalProperties": false
			}
		}
	},
	"required": [
		"firstName",
		"lastName",
		"jobTitle",
		"company",
		"location",
		"timeZone",
		"email",
		"codingSince",
		"proSince",
		"openToWork",
		"resume",
		"photo",
		"socials"
	],
	"additionalProperties": false
}
